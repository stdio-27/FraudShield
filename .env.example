# ──────────────────────────────────────────────────────────────
#  FraudShield — Environment Variables Blueprint
#  Copy this file to .env and fill in production values.
#  ⚠️  NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL / TimescaleDB ──
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db-host:5432/fraudshield

# ── Redis ──
REDIS_URL=redis://redis-host:6379

# ── JWT Authentication ──
# Generate a strong random key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ── Real-Time Alert Webhook ──
# URL to POST high-severity fraud alert payloads (e.g., Slack, PagerDuty, SOC endpoint)
ALERT_WEBHOOK_URL=https://hooks.example.com/your-webhook-endpoint

# ── CORS — Frontend Production URL ──
# Comma-separated list of allowed origins for the browser CORS policy.
# Must match the exact scheme + domain where your React app is deployed.
FRONTEND_PRODUCTION_URL=https://fraudshield.vercel.app

# ── Alert Dispatch Threshold (optional, default 0.85) ──
ALERT_THRESHOLD=0.85
