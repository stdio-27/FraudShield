# ──────────────────────────────────────────────────────────────
#  FraudShield — Environment Variables Blueprint
#  Copy this file to .env and fill in production values.
#  ⚠️  NEVER commit .env to version control.
#  The API and docker compose both read the project-root .env.
# ──────────────────────────────────────────────────────────────

# development | production.  In production the API refuses to start without a strong SECRET_KEY.
APP_ENV=development

# ── Local infrastructure (docker compose) ──
# If you already created the compose volume with the old default password ("password"),
# keep using it here, or run `docker compose down -v` to recreate the database.
POSTGRES_PASSWORD=CHANGE_ME
# pgAdmin login (http://localhost:5050); read by docker-compose.yml with these exact names.
# The email must be a valid address with a real-looking domain (pgAdmin rejects e.g. *.local).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# ── PostgreSQL / TimescaleDB ──
# Compose publishes the database on localhost:5433.  Use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5433/fraudshield

# ── Redis (optional: the API degrades gracefully without it) ──
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ──
# At least 32 characters.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Machine access to POST /transactions/score (sent as the X-API-Key header) ──
# Leave empty to allow only logged-in analysts/admins.
SCORING_API_KEY=
SCORE_RATE_LIMIT_PER_MIN=600

# ── First admin account created by `python -m src.database.init_db` ──
# There is no default login: set both (password >= 12 characters) before running it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Dataset import (init_db) ──
# DATASET_PATH=./creditcard.csv
# Rows loaded into the database for dashboard testing (0 = the whole file, 284,807 rows).
# This does NOT affect training: `python -m src.ml.train` always uses the full CSV.
# Override per run with: python -m src.database.init_db --replace-dataset --limit 50000
DATASET_IMPORT_LIMIT=2000

# ── Model decision threshold (optional) ──
# Defaults to the F1-optimal threshold saved in models/feature_manifest.json by training.
# DECISION_THRESHOLD=0.5

# ── Real-Time Alert Webhook ──
# POSTed when fraud_score >= ALERT_THRESHOLD (e.g., Slack, PagerDuty, SOC endpoint)
# ALERT_WEBHOOK_URL=https://hooks.example.com/your-webhook-endpoint
ALERT_THRESHOLD=0.85

# ── CORS — Frontend Production URL ──
# Comma-separated list of allowed origins (exact scheme + host, no wildcards).
FRONTEND_PRODUCTION_URL=http://localhost:5173

# ── Analytics window anchor ──
# now    = windows end at the current time (default)
# latest = windows end at the newest transaction (static demo data)
ANALYTICS_ANCHOR=now
