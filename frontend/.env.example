# ──────────────────────────────────────────────────────────────
#  FraudShield Frontend — Vite Environment Variables
#  Copy to .env.local for local overrides, or set in Vercel dashboard.
# ──────────────────────────────────────────────────────────────

# Full URL of the deployed FastAPI backend (no trailing slash).
# In local dev this is not needed — the Vite proxy handles /api routing.
VITE_API_BASE_URL=https://your-backend.onrender.com
