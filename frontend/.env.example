# ──────────────────────────────────────────────────────────────
#  FraudShield Frontend — Vite Environment Variables
#  Copy to .env.local for local overrides, or set in Vercel/Render dashboard.
# ──────────────────────────────────────────────────────────────

# Full URL of the FastAPI backend (no trailing slash).
# Defaults to http://localhost:8000 when unset.  The browser calls the backend
# directly, so the backend's FRONTEND_PRODUCTION_URL must list this app's origin
# (http://localhost:5173 in dev; the Vite dev server is pinned to that port).
VITE_API_BASE_URL=https://your-backend.onrender.com
